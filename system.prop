# Basic MagiskHide properties

# RootBeer, Microsoft
ro.build.tags=release-keys

# Other
ro.build.type=user
ro.debuggable=1
ro.secure=0
ro.system.build.fingerprint=google/komodo_beta/komodo:16/BP22.250221.013/13218340:user/release-keys
ro.product.build.fingerprint=google/komodo_beta/komodo:16/BP22.250221.013/13218340:user/release-keys
ro.system_ext.build.fingerprint=google/komodo_beta/komodo:16/BP22.250221.013/13218340:user/release-keys

# optimize parameter
persist.sys.scrollingcache=3
profiler.force_disable_ulog=1
logcat.live=disable
ro.kernel.checkjni=0
ro.config.nocheckin=1
wifi.supplicant_scan_interval=300
pm.sleep_mode=2
